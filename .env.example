# Base URL of the infosys-backend API (including the /api/v1 prefix).
# The backend must allow this origin in CORS_ALLOWED_ORIGINS and the
# frontend must be served from an origin it trusts, since auth uses a
# same-site session cookie.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Usa la capa de datos simulada de lib/runs/mock.ts en lugar de los endpoints
# /api/v1/runs/... (que el backend todavía no implementa). Solo afecta a las
# corridas: el inicio de sesión sigue usando el backend real.
# Escenarios: se eligen desde el selector del dashboard, o incluyendo en el
# nombre del archivo subido fraud | clean_with_leads | clean | partial | failed
# (un nombre con "corrupto" simula un archivo ilegible).
NEXT_PUBLIC_USE_MOCKS=false
